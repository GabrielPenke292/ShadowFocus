{
  "manifest_version": 3,
  "name": "ShadowFocus",
  "version": "1.0.0",
  "description": "Transcrição em tempo real de vídeos do YouTube em inglês, com tradução simultânea para português (BR).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShadowFocus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage", "declarativeNetRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*"
  ]
}
